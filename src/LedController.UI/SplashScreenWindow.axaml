<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LedController.UI.SplashScreenWindow"
        Width="420"
        Height="160"
        MinWidth="420"
        MinHeight="160"
        MaxWidth="420"
        MaxHeight="160"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Title="LedController"
        Background="#1E1E1E"
        Foreground="#E6E6E6">
  <Border Padding="18">
    <StackPanel Spacing="8">
      <TextBlock Text="LedController"
                 FontSize="22"
                 FontWeight="Bold" />
      <TextBlock Text="Betöltés..."
                 FontSize="14"
                 Opacity="0.85" />
      <ProgressBar Margin="0,10,0,0"
                   Height="6"
                   IsIndeterminate="True" />
    </StackPanel>
  </Border>
</Window>
