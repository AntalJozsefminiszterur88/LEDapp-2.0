<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LedController.UI.Converters"
             xmlns:viewModels="clr-namespace:LedController.UI.ViewModels"
             xmlns:models="clr-namespace:LedController.Core.Models;assembly=LedController.Core"
             x:Class="LedController.UI.Views.DeviceControlView"
             x:DataType="viewModels:DeviceControlViewModel"
             x:Name="Root">
  <UserControl.Resources>
    <converters:HexToForegroundBrushConverter x:Key="ColorForegroundConverter"
                                              LightBrush="#F2F2F2"
                                              DarkBrush="#141414"
                                              Threshold="0.6" />
    <converters:EditingColorHexConverter x:Key="EditingColorHexConverter" />
    <converters:EditingColorNameConverter x:Key="EditingColorNameConverter" />
    <converters:EditingColorForegroundConverter x:Key="EditingColorForegroundConverter"
                                                LightBrush="#F2F2F2"
                                                DarkBrush="#141414"
                                                Threshold="0.6" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.color-button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#1A1A1A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,Auto" ColumnSpacing="24">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="{Binding ScheduleButtonLabel}"
              Command="{Binding ToggleScheduleCommand}" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="#242424"
            BorderBrush="#2D2D2D"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,12,0,0">
      <StackPanel Spacing="12">
        <TextBlock Text="Színek" FontSize="14" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding PresetColors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:LedColor">
              <Button Classes="color-button"
                      Command="{Binding DataContext.SetColorCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      ContextRequested="OnColorContextRequested"
                      Margin="4">
                <Button.Content>
                  <MultiBinding Converter="{StaticResource EditingColorNameConverter}">
                    <Binding />
                    <Binding Path="DataContext.EditingColor" ElementName="Root" />
                    <Binding Path="DataContext.EditColorName" ElementName="Root" />
                  </MultiBinding>
                </Button.Content>
                <Button.Background>
                  <MultiBinding Converter="{StaticResource EditingColorHexConverter}">
                    <Binding />
                    <Binding Path="DataContext.EditingColor" ElementName="Root" />
                    <Binding Path="DataContext.EditColorHex" ElementName="Root" />
                  </MultiBinding>
                </Button.Background>
                <Button.Foreground>
                  <MultiBinding Converter="{StaticResource EditingColorForegroundConverter}">
                    <Binding />
                    <Binding Path="DataContext.EditingColor" ElementName="Root" />
                    <Binding Path="DataContext.EditColorHex" ElementName="Root" />
                  </MultiBinding>
                </Button.Foreground>
                <Button.ContextFlyout>
                  <Flyout Placement="Right" Closed="OnColorContextClosed">
                    <StackPanel Spacing="10" Width="320">
                      <TextBlock Text="Szín szerkesztése" FontWeight="SemiBold" />
                      <ColorPicker Color="{Binding DataContext.EditColor, ElementName=Root, Mode=TwoWay}"
                                   Height="220" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="170"
                                 Watermark="Név"
                                 Text="{Binding DataContext.EditColorName, ElementName=Root, Mode=TwoWay}" />
                        <Button Content="Mentés"
                                Command="{Binding DataContext.SaveEditedColorCommand, ElementName=Root}" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.ContextFlyout>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="#1F1F1F"
                BorderBrush="#2D2D2D"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,8,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Egyedi szín" FontSize="13" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomColorHex}" />
              <TextBlock Text="{Binding CustomColorHex}" Opacity="0.7" VerticalAlignment="Center" />
              <Button Content="Színválasztó" Padding="10,6">
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <Border Padding="8">
                      <StackPanel Spacing="10" Width="320">
                        <ColorPicker Color="{Binding CustomColor, Mode=TwoWay}"
                                     Height="220" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBox Width="170"
                                   Watermark="Név"
                                   Text="{Binding CustomColorName, Mode=TwoWay}" />
                          <Button Content="Mentés"
                                  Command="{Binding SaveCustomColorCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Background="#242424"
            BorderBrush="#2D2D2D"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="Fényerő" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <Slider Minimum="0"
          Maximum="100"
          Width="44"
          Height="220"
          Orientation="Vertical"
          HorizontalAlignment="Center"
          Margin="-9,0,0,0"
          Value="{Binding Brightness, Mode=TwoWay}" />
        <TextBlock Text="{Binding Brightness}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
